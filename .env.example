# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free key from Google AI Studio and place it in a local .env file.
# Never share or commit your .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Local web server port (default: 3000)
PORT="3000"

# HOST: Use 127.0.0.1 on Windows to restrict access to your local machine only.
HOST="127.0.0.1"

# APP_URL: Optional hosted URL (automatically injected in AI Studio preview)
APP_URL="http://127.0.0.1:3000"
